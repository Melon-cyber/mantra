<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="14dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#AEA3AB" android:textSize="12sp" android:text="Мантра" />
        <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F6F1F4" android:textSize="20sp" android:textStyle="bold" android:maxLines="1" android:text="Карточки" />
        <TextView android:id="@+id/detail" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#AEA3AB" android:textSize="11sp" android:maxLines="2" />
    </LinearLayout>
    <TextView android:id="@+id/study" android:layout_width="48dp" android:layout_height="48dp"
        android:background="@drawable/widget_button" android:gravity="center" android:text="▶"
        android:textColor="#131014" android:textSize="20sp" android:contentDescription="Повторять" />
</LinearLayout>
